{
  "name": "digikala",
  "version": "0.3.1",
  "description": "A typed SDK for the Digikala Seller OpenAPI.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js",
      "require": "./dist/browser/index.cjs"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js",
      "require": "./dist/node/index.cjs"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.js",
      "require": "./dist/schemas/index.cjs"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js",
      "require": "./dist/auth/index.cjs"
    },
    "./auth/node": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js",
      "require": "./dist/auth/index.cjs"
    },
    "./account-manager": {
      "types": "./dist/account-manager/index.d.ts",
      "import": "./dist/account-manager/index.js",
      "require": "./dist/account-manager/index.cjs"
    },
    "./webhooks": {
      "types": "./dist/webhooks/index.d.ts",
      "import": "./dist/webhooks/index.js",
      "require": "./dist/webhooks/index.cjs"
    },
    "./webhooks/express": {
      "types": "./dist/webhooks/express.d.ts",
      "import": "./dist/webhooks/express.js",
      "require": "./dist/webhooks/express.cjs"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js",
      "require": "./dist/mcp/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "browser": [
        "dist/browser/index.d.ts"
      ],
      "node": [
        "dist/node/index.d.ts"
      ],
      "schemas": [
        "dist/schemas/index.d.ts"
      ],
      "auth": [
        "dist/auth/index.d.ts"
      ],
      "auth/node": [
        "dist/auth/index.d.ts"
      ],
      "account-manager": [
        "dist/account-manager/index.d.ts"
      ],
      "webhooks": [
        "dist/webhooks/index.d.ts"
      ],
      "webhooks/express": [
        "dist/webhooks/express.d.ts"
      ],
      "mcp": [
        "dist/mcp/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "check:browser": "node scripts/check-browser-boundary.mjs",
    "check:exports": "node scripts/check-exports.mjs",
    "clean": "rimraf dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src test tsup.config.ts",
    "lint:fix": "eslint src test tsup.config.ts --fix",
    "prepublishOnly": "npm run verify",
    "test": "vitest run",
    "verify": "npm run check && npm test && npm run build && npm run check:exports && npm run check:browser",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "digikala",
    "seller",
    "sdk",
    "typescript",
    "library"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "axios": "^1.13.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@huggingface/transformers": "^4.3.2",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "better-sqlite3": "^12.4.1",
    "rimraf": "^6.1.3",
    "sqlite-vec": "^0.1.9",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "@huggingface/transformers": "^4.3.2",
    "better-sqlite3": "^12.4.1",
    "sqlite-vec": "^0.1.9"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "sqlite-vec": {
      "optional": true
    }
  },
  "directories": {
    "test": "test"
  },
  "author": ""
}
